   "outputs": [],
   "source": [
    "from sympy import Eq, symbols, Function\n",
    "\n",
    "x, y, t, dt, dx, dy = symbols('x, y, t, dt, dx, dy')\n",
    "C1, C2 = symbols('C1, C2')\n",
    "u = Function('u')(t, x, y)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "fe24a6d3",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle C_{1} \\frac{\\partial}{\\partial x} u{\\left(t,x,y \\right)} + C_{2} \\frac{\\partial}{\\partial y} u{\\left(t,x,y \\right)} + \\frac{\\partial}{\\partial t} u{\\left(t,x,y \\right)} = 0$"
      ],
      "text/plain": [
       "Eq(C1*Derivative(u(t, x, y), x) + C2*Derivative(u(t, x, y), y) + Derivative(u(t, x, y), t), 0)"
      ]
     },
     "execution_count": 4,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "continuous = Eq(u.diff(t) + C1*u.diff(x) + C2*u.diff(y), 0)\n",
    "continuous"
   ]
  },
  {
